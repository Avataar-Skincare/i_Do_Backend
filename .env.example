NODE_ENV=development
# 3011, not 3001 — avoids colliding with partner-app-server, which some local
# setups also run on 3001.
PORT=3011
FRONTEND_ORIGIN=http://localhost:3000

# This website's own database — fully separate from the ring app's Postgres,
# own container (`ido-postgres`, see docker-compose.yml), own `users` table.
# Running this locally (outside Docker) assumes that container is up and
# reachable on the host at the mapped port below.
DB_HOST=localhost
DB_PORT=5433
DB_USER=ido
DB_PASSWORD=ido_dev_password
DB_NAME=ido_website
# true on RDS (encrypted connection); leave false for local Postgres
DB_SSL=false
# Real migrations exist (src/migrations/) — leave this false and use them.
DB_SYNC=false

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Shared secret checked by ApiKeyGuard (src/auth/api-key.guard.ts) on the
# consults/partner/* endpoints — partner-app-server sends this back as
# IDO_BACKEND_API_KEY when it pulls pending leads / confirms a booking.
PARTNER_APP_API_KEY=

# Email (src/mail/mail.service.ts) — AWS SES via nodemailer, same pattern and
# same env var names as partner-app-server's glp-consent-email.service.js, so
# the same AWS credentials can be dropped into both .env files unchanged.
# idowellness.ai (or MAIL_FROM_ADDRESS specifically) must be a verified SES
# identity before sending will actually work.
AWS_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
MAIL_FROM_ADDRESS=support@idowellness.ai

# Payments (src/payments/razorpay.service.ts) — test-mode keys from the
# Razorpay dashboard. Nothing in the online-checkout flow works without
# these: RazorpayService throws rather than silently accepting a payment
# with an empty key. Use test-mode keys (prefixed rzp_test_) until this is
# actually ready to take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Phone login OTP (src/sms/fast2sms.service.ts) — same Fast2SMS DLT route the
# Client repo (avataarskin.com) uses for its own signup/login OTP.
# FAST2SMS_API_KEY is the only required one; sender ID and template default
# to the Client repo's own values below, which are registered under
# Avataar's DLT entity, not i do's — confirm with Fast2SMS/DLT that this
# template's approved wording is acceptable to send under the i do brand
# before relying on this in production. Override either once i do has its
# own registered sender ID/template.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=AVTSKC
FAST2SMS_OTP_TEMPLATE_ID=185443

# Same phone OTP also goes out over WhatsApp (src/sms/whatsapp.service.ts),
# fire-and-forget alongside the SMS — ported from the Client repo's internal
# "Messenger" WhatsApp Business gateway. Workspace/template default to the
# Client repo's own registered values; same caveat as Fast2SMS above — confirm
# this template's approved wording fits the i do brand before going live.
# A blank MESSENGER_WEBHOOK_URL/MESSENGER_API_KEY just skips the WhatsApp send
# (logs a warning) — it never blocks the SMS OTP from going out.
MESSENGER_WEBHOOK_URL=
MESSENGER_API_KEY=
MESSENGER_WORKSPACE_ID=2
MESSENGER_OTP_TEMPLATE=otp9
